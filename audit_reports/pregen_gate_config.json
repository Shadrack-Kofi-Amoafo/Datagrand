    "max_combo_reuse": 1,
    "min_template_fraction": 0.5,
    "max_template_share": 0.05,
    "max_cluster_share": 0.02,
    "min_entity_pool": 0,
    "max_quarantine_overlap": 0.2,
    "similarity_threshold": 0.9,
    "similarity_ngram": 5,
    "max_label_padding_factor": 2.0
  },
